# PostgreSQL connection string. As of v0.18, cmd/mailx reads this too: if
# set, `mailx` (no args) also runs the API/queue/worker pipeline alongside
# SMTP, not just the original SMTP-only receiver.
DATABASE_URL=postgres://localhost:5432/mailx?sslmode=disable

# Overrides DATABASE_URL for internal/database's integration tests.
MAILX_TEST_DATABASE_URL=postgres://localhost:5432/mailx_test?sslmode=disable

# Redis address used by internal/queue's RedisQueue integration tests,
# and by cmd/mailx's queue/worker pipeline when DATABASE_URL is set.
REDIS_ADDR=localhost:6379

# v0.18 API server listen address.
MAILX_HTTP_ADDR=:8080

# v0.19 API-key verifier pepper (see internal/auth's package doc for
# exactly what it does and does not protect against). Unset is a valid
# local-dev choice (verifiers fall back to unkeyed SHA-256); set a real
# random value before handling real credentials. Never commit a real one.
MAILX_API_KEY_PEPPER=local-dev-pepper-not-for-production
MAILX_WEBHOOK_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MAILX_WEBHOOK_ALLOW_INSECURE=true
MAILX_WEBHOOK_WORKERS=4

# v0.23 observability. Log level: debug|info|warn|error (default info).
# Log format: json (default, machine-readable) or text (local development).
# Operator listener for /metrics and /health/*: default :9090; set to an
# empty value to disable. Keep it off public networks.
MAILX_LOG_LEVEL=info
MAILX_LOG_FORMAT=json
MAILX_OBSERVABILITY_ADDR=:9090

# --- docker compose (compose.yaml) ---
# Development-only defaults for the containerized PostgreSQL service.
# Never real credentials; compose.yaml substitutes these into the
# in-container DATABASE_URL used by the mailx/migrate services (they
# connect to the "postgres" service, not localhost). Override in your own
# untracked .env before running compose against anything beyond a
# throwaway local database.
POSTGRES_USER=mailx
POSTGRES_PASSWORD=mailx-dev-only
POSTGRES_DB=mailx

# cmd/mailx runtime configuration; defaults already match local dev.
MAILX_SMTP_ADDR=:2525
MAILX_STORAGE_ROOT=
